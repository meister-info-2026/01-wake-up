# Raspberry Pi 5 Daemon Environment Variables Template

# FastAPI Backend URL
# IMPORTANT: When running on Raspberry Pi, use your PC's IP address (e.g., http://192.168.0.25:8000) or Render URL!
# Do NOT use 'localhost' because localhost refers to the Raspberry Pi itself.
BACKEND_URL=http://192.168.0.100:8000

# Device Authentication Key (Must match backend DEVICE_API_KEY)
DEVICE_API_KEY=your_secret_device_api_key_here

# GPIOZERO Pin Factory (lgpio is required for Raspberry Pi 5 RP1 chipset)
GPIOZERO_PIN_FACTORY=lgpio
